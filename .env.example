# LLM provider: ollama (default, local, free) | anthropic | openai | none (extractive, no LLM)
RAG_LLM_PROVIDER=ollama
# Leave empty for the provider default (ollama: qwen3.5:4b, anthropic: claude-haiku-5-5, openai: gpt-4o-mini)
RAG_LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval: vector | bm25 | hybrid | hybrid_rerank
RAG_RETRIEVAL_MODE=hybrid_rerank
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=-2.0
# stricter gate applied (against the original question) after a query rewrite
RAG_REWRITE_THRESHOLD=0.0
